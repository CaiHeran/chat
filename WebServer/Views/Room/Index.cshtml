@using System.Security.Claims
@model RoomViewModel
@{
    ViewData["Title"] = Model.Name;
}
<h3>Room: @Model.Name (@Model.Id)</h3>

@if ((bool?)ViewData["IsInRoom"] == false)
{
    <div class="alert alert-info">
        <p>您还未加入此房间。<button id="joinRoomBtn" class="btn btn-primary btn-sm">加入房间</button></p>
    </div>
}

<div id="messagesListContainer" style="border: 1px solid #ccc; padding: 10px; margin-bottom: 20px; height: 300px; overflow-y: scroll;">
    <h4>Messages:</h4>
    <ul id="messagesUl">
        @if (Model.Messages != null && Model.Messages.Any())
        {
            @foreach (var message in Model.Messages.OrderBy(m => m.Time))
            {
                <li class="message-item" data-message-time="@message.Time.Ticks" data-sender="@message.SenderId">
                    <strong>@message.SenderName</strong>
                    <span style="font-size: 0.8em; color: #777;">(@message.Time.ToLocalTime().ToString("g"))</span>:
                    <p style="margin-left: 10px; margin-top: 0; margin-bottom: 5px; white-space: pre-wrap; word-break: break-word;">@message.Content</p>
                </li>
            }
        }
        else
        {
            <li id="noMessagesLi">No messages in this room yet.</li>
        }
    </ul>
</div>

@if ((bool?)ViewData["IsInRoom"] == true)
{
    <hr />
    <h4>Send a new message:</h4>
    <form id="sendMessageForm">
        <div class="form-group mb-3">
            <label for="messageInput">Message:</label>
            <textarea id="messageInput" class="form-control" rows="3" required></textarea>
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-primary">Send</button>
            <button type="button" id="leaveRoomBtn" class="btn btn-secondary ms-2">Leave Room</button>
        </div>
    </form>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-2">
        @TempData["ErrorMessage"]
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const roomId = "@Model.Id";
            const currentUserId = "@User.FindFirstValue(ClaimTypes.NameIdentifier)";
            const messageInput = document.getElementById('messageInput');
            const messagesUl = document.getElementById('messagesUl');
            const messagesListContainer = document.getElementById('messagesListContainer');
            const noMessagesLi = document.getElementById('noMessagesLi');
            const joinRoomBtn = document.getElementById('joinRoomBtn');
            const leaveRoomBtn = document.getElementById('leaveRoomBtn');
            const sendMessageForm = document.getElementById('sendMessageForm');
            
            let isInRoom = @((bool?)ViewData["IsInRoom"] == true ? "true" : "false");
            let lastMarkAsReadTime = Date.now();
            let isUserScrolling = false;
            let lastMessageTime = 0;

            // 创建 Intersection Observer 用于检测消息可见性
            let visibilityObserver = null;
            
            if (isInRoom) {
                visibilityObserver = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const messageElement = entry.target;
                            const senderId = messageElement.dataset.sender;
                            const messageTime = parseInt(messageElement.dataset.messageTime);
                            
                            // 只处理其他用户的消息
                            if (senderId !== currentUserId && messageTime > lastMessageTime) {
                                markMessageAsRead(messageTime);
                            }
                        }
                    });
                }, {
                    root: messagesListContainer,
                    rootMargin: '0px',
                    threshold: 0.7 // 消息70%可见时才算已读
                });
            }

            // 创建 SignalR 连接
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/chathub")
                .configureLogging(signalR.LogLevel.Information)
                .build();

            // 格式化时间戳
            function formatTimestamp(timestamp) {
                return new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            }

            // 检查用户是否在底部附近（用于判断是否自动滚动）
            function isNearBottom() {
                const threshold = 80; // 80px 容差
                return messagesListContainer.scrollHeight - messagesListContainer.clientHeight - messagesListContainer.scrollTop <= threshold;
            }

            // 检查新消息是否应该触发自动滚动
            function shouldAutoScrollToNewMessage() {
                // 如果用户正在主动滚动，不要干扰
                if (isUserScrolling) return false;
                
                // 只有当用户在底部附近时才自动滚动
                return isNearBottom();
            }

            // 标记特定时间的消息为已读
            function markMessageAsRead(messageTime) {
                if (!isInRoom) return;
                
                const now = Date.now();
                // 防抖：1秒内最多发送一次请求
                if (now - lastMarkAsReadTime > 1000) {
                    lastMarkAsReadTime = now;
                    lastMessageTime = Math.max(lastMessageTime, messageTime);
                    
                    fetch('/Room/MarkAsRead', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify({ roomId: parseInt(roomId) })
                    }).catch(error => {
                        console.error('Error marking messages as read:', error);
                    });
                }
            }

            // 将新消息附加到列表的函数
            function appendMessage(user, message, timestamp, senderId = null) {
                // 在添加新消息之前，先检查用户是否在原先的底部附近
                const wasNearBottom = shouldAutoScrollToNewMessage();
                
                if (noMessagesLi) {
                    noMessagesLi.style.display = 'none';
                }

                const li = document.createElement("li");
                li.className = "message-item";
                li.dataset.messageTime = new Date(timestamp).getTime();
                li.dataset.sender = senderId || "unknown";

                const strong = document.createElement("strong");
                strong.textContent = user;

                const timeSpan = document.createElement("span");
                timeSpan.style.fontSize = "0.8em";
                timeSpan.style.color = "#777";
                timeSpan.textContent = ` (${formatTimestamp(timestamp)})`;

                const p = document.createElement("p");
                p.style.marginLeft = "10px";
                p.style.marginTop = "0";
                p.style.marginBottom = "5px";
                p.style.whiteSpace = "pre-wrap"; // 保持换行和空格
                p.style.wordBreak = "break-word"; // 长单词换行
                // 使用 textContent 设置文本，浏览器会自动处理换行符
                p.textContent = message;

                li.appendChild(strong);
                li.appendChild(timeSpan);
                li.appendChild(document.createTextNode(": "));
                li.appendChild(p);
                messagesUl.appendChild(li);

                // 根据之前检查的结果决定是否滚动
                if (wasNearBottom) {
                    if (senderId === currentUserId) {
                        // 自己的消息：滚动到底部
                        messagesListContainer.scrollTo({
                            top: messagesListContainer.scrollHeight,
                            behavior: 'smooth'
                        });
                    } else {
                        // 其他人的消息：滚动到新消息的开头
                        li.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'  // 滚动到元素的开头
                        });
                    }
                }

                // 为新消息设置可见性观察
                if (isInRoom && visibilityObserver && senderId !== currentUserId) {
                    visibilityObserver.observe(li);
                }

                // 如果消息立即可见，标记为已读
                if (senderId !== currentUserId) {
                    setTimeout(() => {
                        const rect = li.getBoundingClientRect();
                        const containerRect = messagesListContainer.getBoundingClientRect();
                        
                        if (rect.top >= containerRect.top && rect.bottom <= containerRect.bottom) {
                            markMessageAsRead(new Date(timestamp).getTime());
                        }
                    }, 100);
                }
            }

            // 监听用户滚动状态
            let scrollTimeout;
            messagesListContainer.addEventListener('scroll', () => {
                isUserScrolling = true;
                clearTimeout(scrollTimeout);
                // 用户停止滚动后稍等一段时间再允许自动滚动
                scrollTimeout = setTimeout(() => {
                    isUserScrolling = false;
                }, 1500); // 1.5秒，比较合理的时间
            });

            // 监听用户交互，暂停自动滚动
            messagesListContainer.addEventListener('mousedown', () => {
                isUserScrolling = true;
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(() => {
                    isUserScrolling = false;
                }, 2000); // 鼠标交互后2秒内不自动滚动
            });

            // 监听滚轮事件
            messagesListContainer.addEventListener('wheel', () => {
                isUserScrolling = true;
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(() => {
                    isUserScrolling = false;
                }, 1500);
            });

            // SignalR 事件处理
            connection.on("ReceiveMessage", (user, message, timestamp, senderId) => {
                appendMessage(user, message, timestamp, senderId);
            });

            connection.on("UserJoined", (userName, timestamp) => {
                appendMessage("System", `${userName} joined the room`, timestamp, "system");
            });

            connection.on("UserLeft", (userName, timestamp) => {
                appendMessage("System", `${userName} left the room`, timestamp, "system");
            });

            connection.on("Error", (errorMessage) => {
                console.error("SignalR Error:", errorMessage);
                
                // 如果是认证错误，重定向到登录页面
                if (errorMessage.includes("Invalid user session") || 
                    errorMessage.includes("User not authenticated")) {
                    alert("Your session has expired. Please log in again.");
                    window.location.href = "/Identity/Account/Logout";
                } else {
                    alert("Error: " + errorMessage);
                }
            });

            // 启动连接
            async function startConnection() {
                try {
                    await connection.start();
                    console.log("SignalR Connected.");
                    if (isInRoom) {
                        await connection.invoke("AddToRoom", roomId);
                        console.log(`Joined room: ${roomId}`);
                    }
                } catch (err) {
                    console.error("SignalR Connection Error: ", err);
                    setTimeout(startConnection, 5000);
                }
            }

            connection.onclose(async () => {
                console.log("SignalR connection closed. Attempting to reconnect...");
                await startConnection();
            });

            startConnection();

            // 初始化现有消息的可见性观察
            if (isInRoom && visibilityObserver) {
                document.querySelectorAll('.message-item').forEach(messageElement => {
                    const senderId = messageElement.dataset.sender;
                    if (senderId !== currentUserId) {
                        visibilityObserver.observe(messageElement);
                    }
                });
            }

            // 加入房间按钮
            if (joinRoomBtn) {
                joinRoomBtn.addEventListener('click', async () => {
                    try {
                        const response = await fetch(`/Room/JoinRoom`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                            },
                            body: JSON.stringify({ roomId: parseInt(roomId) })
                        });
                        
                        const result = await response.json();
                        if (result.success) {
                            location.reload();
                        } else {
                            alert('Failed to join room: ' + result.message);
                        }
                    } catch (error) {
                        console.error('Error joining room:', error);
                        alert('Error joining room');
                    }
                });
            }

            // 离开房间按钮
            if (leaveRoomBtn) {
                leaveRoomBtn.addEventListener('click', async () => {
                    if (confirm('Are you sure you want to leave this room?')) {
                        try {
                            const response = await fetch(`/Room/LeaveRoom`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                                },
                                body: JSON.stringify({ roomId: parseInt(roomId) })
                            });
                            
                            const result = await response.json();
                            if (result.success) {
                                window.location.href = '/Rooms';
                            } else {
                                alert('Failed to leave room');
                            }
                        } catch (error) {
                            console.error('Error leaving room:', error);
                            alert('Error leaving room');
                        }
                    }
                });
            }

            // 发送消息表单
            if (sendMessageForm) {
                sendMessageForm.addEventListener('submit', async (event) => {
                    event.preventDefault();

                    // 获取原始消息内容，只移除结尾空白，保留内部换行符
                    const message = messageInput.value.replace(/\s+$/g, '');
                    if (!message) return;

                    if (connection.state === signalR.HubConnectionState.Connected) {
                        try {
                            await connection.invoke("SendMessageToRoom", roomId, message);
                            messageInput.value = "";
                            messageInput.focus();
                        } catch (err) {
                            console.error("Error sending message via SignalR: ", err);
                            alert("Error sending message. Please try again.");
                        }
                    } else {
                        alert("Not connected to chat server. Please wait or refresh.");
                    }
                });
            }

            // 页面加载时滚动到底部
            if (isInRoom && messagesUl.children.length > 0 && (!noMessagesLi || noMessagesLi.style.display === 'none')) {
                // 页面加载时直接滚动到底部，无动画
                setTimeout(() => {
                    messagesListContainer.scrollTop = messagesListContainer.scrollHeight;
                }, 100);
            }

            // 页面卸载时清理观察器
            window.addEventListener('beforeunload', () => {
                if (visibilityObserver) {
                    visibilityObserver.disconnect();
                }
            });
        });
    </script>
}

<style>
    .message-item {
        transition: background-color 0.3s ease;
    }
    
    .message-item.new-message {
        background-color: #f8f9fa;
        border-left: 3px solid #007bff;
        padding-left: 10px;
    }
    
    #messagesListContainer {
        scroll-behavior: smooth;
    }
</style>